# copie para .env e ajuste antes de rodar `docker compose up`
DB_PASSWORD=troque-esta-senha
# 32+ caracteres aleatórios: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# gere com: docker compose run --rm --no-deps api python -m app.hash_senha 'sua-senha'
# mantenha as ASPAS SIMPLES: o hash tem "$" e o compose tentaria interpolar
ADMIN_PASSWORD_HASH=''
S3_ACCESS_KEY=natanael
S3_SECRET_KEY=troque-esta-senha-do-minio
S3_PUBLIC_URL=http://localhost:9000/imoveis
# endereço público da API, embutido no build do site
VITE_API_URL=http://localhost:3001
# de onde o site é servido (a API só aceita chamadas do navegador vindas daqui)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# cookie de sessão (refresh token). Em produção com HTTPS: COOKIE_SECURE=true.
# Se o site e a API ficarem em domínios diferentes: COOKIE_SAMESITE=none (exige secure=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
